{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegistryDataset",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "key",
      "countryCode",
      "partyId",
      "eMobilityId",
      "role",
      "status",
      "organization",
      "source",
      "metadata"
    ],
    "properties": {
      "key": {
        "type": "string"
      },
      "countryCode": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      },
      "partyId": {
        "type": "string",
        "pattern": "^[A-Z0-9]{3}$"
      },
      "eMobilityId": {
        "type": "string",
        "pattern": "^[A-Z]{2}[A-Z0-9]{3}$"
      },
      "role": {
        "enum": [
          "CPO",
          "CSO",
          "EMSP",
          "NSP",
          "HUB",
          "OTHER"
        ]
      },
      "status": {
        "enum": [
          "ACTIVE",
          "INACTIVE",
          "RESERVED",
          "REVOKED",
          "UNKNOWN"
        ]
      },
      "organization": {
        "type": "object"
      },
      "source": {
        "type": "object",
        "properties": {
          "observation": {
            "type": "object",
            "required": [
              "kind",
              "observingJurisdiction"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "ASSIGNMENT",
                  "CROSS_REGISTER_LISTING"
                ]
              },
              "observingJurisdiction": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Z]{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      },
      "metadata": {
        "type": "object"
      },
      "issuing": {
        "type": "object",
        "required": [
          "country",
          "confirmation",
          "confirmedBy"
        ],
        "properties": {
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "confirmation": {
            "enum": [
              "CONFIRMED",
              "NOT_FOUND",
              "SOURCE_STALE",
              "SOURCE_UNAVAILABLE",
              "UNSUPPORTED_ROLE",
              "NO_ISSUING_SOURCE"
            ]
          },
          "confirmedBy": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
